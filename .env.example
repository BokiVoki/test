# ─── Telegram ───────────────────────────────────────────────
# @BotFather 에서 /newbot 으로 발급
TELEGRAM_BOT_TOKEN=

# @userinfobot 에게 메시지 보내면 알려줌
TELEGRAM_USER_ID=

# ─── Anthropic ──────────────────────────────────────────────
# console.anthropic.com
ANTHROPIC_API_KEY=

# ─── Google Sheets ──────────────────────────────────────────
# 서비스 계정 JSON 파일 내용 전체를 한 줄로 붙여넣기
# (Railway 등 클라우드 배포 시 파일 대신 이 환경변수 사용)
GOOGLE_CREDENTIALS_JSON=

# Google Sheet URL 에서 /d/ 뒤, /edit 앞 부분
SPREADSHEET_ID=

# ─── 인박스 봇 (옵시디언 정리용, 별도 봇) ──────────────────
# @BotFather 에서 새로 발급한 두 번째 봇 토큰
INBOX_BOT_TOKEN=

# 옵시디언 볼트로 쓸 GitHub 저장소 (owner/repo)
VAULT_REPO=
# 기본 main (저장소 기본 브랜치)
VAULT_BRANCH=main
# 볼트 저장소에 쓰기 권한 있는 Personal Access Token (Fine-grained, Contents: Read and write)
GITHUB_TOKEN=
# (선택) 요약 모델 — 기본 claude-sonnet-5
INBOX_SUMMARY_MODEL=claude-sonnet-5

# ─── 하루앱 웹 푸시 알림 (아이폰은 "홈 화면에 추가" 설치 후에만 수신) ───
# 한 번만 생성해서 고정하는 키 쌍 — 공개키는 webapp/index.html의 VAPID_PUBLIC_KEY와
# 반드시 같은 값이어야 함(하나 바꾸면 둘 다 바꿔야 기존 구독이 안 깨짐)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# (선택) mailto: 주소, 기본 mailto:lolcv1294@gmail.com
VAPID_SUBJECT=
# 하루앱 Supabase 연결(이미 SUPABASE_URL/SUPABASE_SERVICE_KEY/HARU_OWNER_ID를
# 넣어뒀다면 그대로 재사용됨 — bot/haru_app.py 참고)
